/* Programa de prueba para la traduccion Chapin -> Nova.
   Cubre: declaracion con y sin inicializacion, declaracion anidada en un
   bloque, aguas, clavar, brega, cabal/sino, shute con concatenacion y
   operadores aritmeticos/relacionales. */

va pisto contador = 0;
va pisto limite;
va quetzal promedio = 0.0;

aguas "¿Hasta qué número quieres bregar?";
clavar(limite);

brega (contador < limite) {
    shute("Vuelta: " + contador);
    promedio = promedio + contador;
    contador = contador + 1;

    cabal (contador == 3) {
        va pisto temporal = contador * 2;
        shute("Temporal: " + temporal);
    }
}

promedio = promedio / limite;

cabal (promedio > 5) {
    shute("Promedio alto, quedó cabal: " + promedio);
} sino {
    shute("Promedio bajo: " + promedio);
}
