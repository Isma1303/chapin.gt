entero contador;
entero limite;
decimal promedio;
entero temporal;

contador = 0;
promedio = 0.0;
imprimir("¿Hasta qué número quieres bregar?");
// clavar(limite): no soportado en Nova
mientras contador < limite hacer
    imprimir("Vuelta: " + contador);
    promedio = promedio + contador;
    contador = contador + 1;
    si contador == 3 entonces
        temporal = contador * 2;
        imprimir("Temporal: " + temporal);
    fin
fin
promedio = promedio / limite;
si promedio > 5 entonces
    imprimir("Promedio alto, quedó cabal: " + promedio);
sino
    imprimir("Promedio bajo: " + promedio);
fin
